{
  "name": "dsh-plugin-conversation-toolkit",
  "version": "0.3.0",
  "description": "Conversation toolkit for DeepSeek Harness: copy a whole conversation as Markdown, copy a deep link that reopens it, edit a user message and resend it, and branch a turn or its reasoning away.",
  "type": "module",
  "license": "MIT",
  "author": "hd25071",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "conversation",
    "markdown",
    "deep-link",
    "search"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hd25071/dsh-plugin-conversation-toolkit.git"
  },
  "homepage": "https://github.com/hd25071/dsh-plugin-conversation-toolkit#readme",
  "bugs": {
    "url": "https://github.com/hd25071/dsh-plugin-conversation-toolkit/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/**/*.test.mjs",
    "check": "node --check client/client.js && node --test test/**/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
